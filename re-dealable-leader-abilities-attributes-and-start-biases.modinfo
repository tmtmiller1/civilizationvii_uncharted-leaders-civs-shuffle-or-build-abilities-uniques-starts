	<ActionGroups>
		<!-- Setup: parameters, the setup-side copy, text and the setup scripts. LoadOrder 20000 runs after leader mods
		     have added their frontend Leaders rows. -->
		<ActionGroup id="lshuf-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>20000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/schema/gameplay-tables.sql</Item>
					<Item>data/schema/frontend-tables.sql</Item>
					<Item>data/frontend/parameters.sql</Item>
					<Item>data/mapping/lshuf-mapping.sql</Item>
					<Item>data/mapping/lshuf-civ-mapping.sql</Item>
					<Item>data/generated/known-leaders.sql</Item>
					<Item>data/setup-copy/setup-copy.sql</Item>
					<Item>data/setup-copy/setup-copy-civ.sql</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/lshuf-text.xml</Item>
					<!-- The per-bullet text, so the build screens and the preview read each bonus in the player's language. -->
					<Item>data/text-generated/lshuf-piece-text.sql</Item>
					<Item>data/text-generated/lshuf-civ-piece-text.sql</Item>
					<!-- The game's agenda text only loads in a game; the AI behavior cards need it here (text/agenda/). -->
					<Item locale="de_DE">text/agenda/de_DE.xml</Item>
					<Item>text/agenda/en_US.xml</Item>
					<Item locale="es_ES">text/agenda/es_ES.xml</Item>
					<Item locale="fr_FR">text/agenda/fr_FR.xml</Item>
					<Item locale="it_IT">text/agenda/it_IT.xml</Item>
					<Item locale="ja_JP">text/agenda/ja_JP.xml</Item>
					<Item locale="ko_KR">text/agenda/ko_KR.xml</Item>
					<Item locale="pl_PL">text/agenda/pl_PL.xml</Item>
					<Item locale="pt_BR">text/agenda/pt_BR.xml</Item>
					<Item locale="ru_RU">text/agenda/ru_RU.xml</Item>
					<Item locale="zh_Hans_CN">text/agenda/zh_Hans_CN.xml</Item>
					<Item locale="zh_Hant_HK">text/agenda/zh_Hant_HK.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/setup/lshuf-setup.js</Item>
					<Item>ui/display/lshuf-setup-display.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>shared/deal/lshuf-deal-ability.js</Item>
					<Item>shared/deal/lshuf-deal-attributes.js</Item>
					<Item>shared/deal/lshuf-deal-axes.js</Item>
					<Item>shared/deal/lshuf-deal-bias-stats.js</Item>
					<Item>shared/deal/lshuf-deal-biases.js</Item>
					<Item>shared/deal/lshuf-deal-build.js</Item>
					<Item>shared/deal/lshuf-deal-civ.js</Item>
					<Item>shared/deal/lshuf-deal-input.js</Item>
					<Item>shared/deal/lshuf-deal-unlocks.js</Item>
					<Item>shared/deal/lshuf-deal-util.js</Item>
					<Item>shared/deal/lshuf-deal.js</Item>
					<Item>shared/lshuf-constants.js</Item>
					<Item>shared/lshuf-key.js</Item>
					<Item>shared/lshuf-known-civ-items.js</Item>
					<Item>shared/lshuf-known-civs.js</Item>
					<Item>shared/lshuf-known-leaders.js</Item>
					<Item>shared/lshuf-text.js</Item>
					<Item>ui/display/lshuf-config-rows.js</Item>
					<Item>ui/display/lshuf-display-text.js</Item>
					<Item>ui/display/lshuf-display-util.js</Item>
					<Item>ui/display/lshuf-setup-display.js</Item>
					<Item>ui/game/lshuf-city-details-names.js</Item>
					<Item>ui/game/lshuf-game-data.js</Item>
					<Item>ui/game/lshuf-game-transition.js</Item>
					<Item>ui/game/lshuf-game.js</Item>
					<Item>ui/game/lshuf-reveal-panel.js</Item>
					<Item>ui/img/terrain/coast.png</Item>
					<Item>ui/img/terrain/desert.png</Item>
					<Item>ui/img/terrain/flat.png</Item>
					<Item>ui/img/terrain/floodplain.png</Item>
					<Item>ui/img/terrain/grassland.png</Item>
					<Item>ui/img/terrain/hill.png</Item>
					<Item>ui/img/terrain/island.png</Item>
					<Item>ui/img/terrain/lake.png</Item>
					<Item>ui/img/terrain/mountain.png</Item>
					<Item>ui/img/terrain/natural_wonder.png</Item>
					<Item>ui/img/terrain/navigable_river.png</Item>
					<Item>ui/img/terrain/plains.png</Item>
					<Item>ui/img/terrain/river.png</Item>
					<Item>ui/img/terrain/tropical.png</Item>
					<Item>ui/img/terrain/tundra.png</Item>
					<Item>ui/img/terrain/vegetated.png</Item>
					<Item>ui/setup/lshuf-ai-window.js</Item>
					<Item>ui/setup/lshuf-build-art.js</Item>
					<Item>ui/setup/lshuf-build-cards.js</Item>
					<Item>ui/setup/lshuf-build-entry.js</Item>
					<Item>ui/setup/lshuf-build-parts.js</Item>
					<Item>ui/setup/lshuf-build-tooltip.js</Item>
					<Item>ui/setup/lshuf-build-tree.js</Item>
					<Item>ui/setup/lshuf-build-window.js</Item>
					<Item>ui/setup/lshuf-build.css</Item>
					<Item>ui/setup/lshuf-mod-check.js</Item>
					<Item>ui/setup/lshuf-presets.js</Item>
					<Item>ui/setup/lshuf-setup-accordion.js</Item>
					<Item>ui/setup/lshuf-setup-config.js</Item>
					<Item>ui/setup/lshuf-setup-controls.js</Item>
					<Item>ui/setup/lshuf-setup-params.js</Item>
					<Item>ui/setup/lshuf-setup-section.js</Item>
					<Item>ui/setup/lshuf-setup-start.js</Item>
					<Item>ui/setup/lshuf-setup-window.js</Item>
					<Item>ui/setup/lshuf-setup.css</Item>
					<Item>ui/setup/lshuf-setup.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<!-- Game: our tables and the mapping first. LoadOrder 20000 sits above Partisans (10000) and Cultural Diffusion
		     (60), so the deal sees their LeaderTraits rows and leaves them alone. -->
		<ActionGroup id="lshuf-game-schema" scope="game" criteria="always">
			<Properties><LoadOrder>20000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/schema/gameplay-tables.sql</Item>
					<Item>data/mapping/lshuf-mapping.sql</Item>
					<Item>data/mapping/lshuf-civ-mapping.sql</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<!-- Generated by scripts/generate/generate.mjs (workstream B). Don't edit by hand. -->
		<ActionGroup id="lshuf-known-leaders" scope="game" criteria="always">
			<Properties><LoadOrder>20010</LoadOrder></Properties>
			<Actions><UpdateDatabase><Item>data/generated/known-leaders.sql</Item></UpdateDatabase></Actions>
		</ActionGroup>
