<?xml version="1.0" encoding="utf-8"?>
<Mod id="lshuf-probe-crossage" version="1" xmlns="ModInfo">
	<Properties>
		<Name>Uncharted Leaders &amp; Civs cross-age probe</Name>
		<Description>Puts America's +1 Production on Resources on every Antiquity civilization. Not for release.</Description>
		<Authors>tower</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>1</AffectsSavedGames>
		<ShowInBrowser>1</ShowInBrowser>
	</Properties>
	<Dependencies>
		<Mod id="core" title="Core"/>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="lshuf-probe-crossage-game" scope="game" criteria="always">
			<Properties><LoadOrder>9000</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase><Item>data/crossage.sql</Item></UpdateDatabase>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
