<?xml version="1.0" encoding="utf-8"?>
<Mod id="lshuf-probe-window" version="1" xmlns="ModInfo">
	<Properties>
		<Name>Leader Shuffle probe: setup window</Name>
		<Description>Probe 16 for the spec. Not for release.</Description>
		<Authors>tower</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="core" title="Core"/>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
		<Criteria id="hidden-on"><ConfigurationValueMatches><Group>Game</Group><ConfigurationId>LShufP16Hidden</ConfigurationId><Value>1</Value></ConfigurationValueMatches></Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="lshuf-probe-window-shell" scope="shell" criteria="always">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions>
				<UpdateDatabase><Item>data/setup-params.sql</Item></UpdateDatabase>
				<UpdateText><Item>text/setup-text.sql</Item></UpdateText>
				<UIScripts><Item>ui/lshuf-probe-window.js</Item></UIScripts>
			</Actions>
		</ActionGroup>
		<ActionGroup id="lshuf-probe-window-game" scope="game" criteria="always">
			<Properties><LoadOrder>100</LoadOrder></Properties>
			<Actions><UpdateDatabase><Item>data/hits-table.sql</Item></UpdateDatabase></Actions>
		</ActionGroup>
		<ActionGroup id="lshuf-probe-window-hit" scope="game" criteria="hidden-on">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<Actions><UpdateDatabase><Item>data/hit-hidden.sql</Item></UpdateDatabase></Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
